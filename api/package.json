    "@types/multer": "^2.3.0",
    "@types/node": "^24.0.0",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "dotenv": "^17.2.3",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prisma": "^7.10.0",
    "tsx": "^4.20.6",
    "typescript": "^6.0.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.2"
  }
