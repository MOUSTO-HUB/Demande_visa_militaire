# Copier ce fichier en .env puis adapter les valeurs.

# --- Base de données (docker-compose) ---
POSTGRES_USER=visa
POSTGRES_PASSWORD=visa_dev
POSTGRES_DB=demande_visa
POSTGRES_PORT=5436
DATABASE_URL=postgresql://visa:visa_dev@localhost:5436/demande_visa?schema=public

# --- API ---
API_PORT=3200
WEB_ORIGIN=http://localhost:3002

# --- Site (Next.js) : appels serveur vers l'API (jamais exposé au navigateur) ---
API_URL=http://localhost:3200/api

# --- Authentification ---
# Au moins 32 caractères aléatoires. Générer avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=a-remplacer-par-une-valeur-aleatoire-de-48-caracteres
# Mot de passe des comptes de démonstration créés par pnpm db:seed
SEED_MOT_DE_PASSE=Visa-Dev-2026

# --- Pièces (scans de passeport, photos…) ---
# Dossier relatif à api/ ; les fichiers y sont chiffrés (AES-256-GCM).
STOCKAGE_DIR=stockage
# Clé de chiffrement des pièces : 32 octets en base64. Générer avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# La perdre rend les pièces illisibles : la sauvegarder à part.
CLE_PIECES=
