{
  "name": "demande_visa_militaire",
  "version": "0.1.0",
  "private": true,
  "description": "Préparation et suivi des demandes de visa d'études des militaires boursiers (DGRECM)",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @visa/api db:migrate",
    "db:seed": "pnpm --filter @visa/api db:seed",
    "db:studio": "pnpm --filter @visa/api db:studio",
    "dev:api": "pnpm --filter @visa/api start:dev",
    "dev:web": "pnpm --filter @visa/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.9.9"
  }
}
