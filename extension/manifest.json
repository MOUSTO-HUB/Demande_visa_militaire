{
  "manifest_version": 3,
  "name": "Visa DGRECM – Remplisseur",
  "short_name": "Visa DGRECM",
  "version": "0.1.0",
  "description": "Relève les champs du formulaire officiel de demande de visa (Chine) et les remplit depuis les dossiers validés de la DGRECM. L'agent garde le captcha, les pièces et la soumission.",
  "minimum_chrome_version": "111",
  "action": {
    "default_title": "Visa DGRECM",
    "default_popup": "popup.html"
  },
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "https://consular.mfa.gov.cn/*",
    "http://localhost:3200/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "content_scripts": [
    {
      "matches": ["https://consular.mfa.gov.cn/*"],
      "js": ["pont.js"],
      "all_frames": false,
      "run_at": "document_idle"
    },
    {
      "matches": ["https://consular.mfa.gov.cn/*"],
      "js": ["page.js"],
      "all_frames": false,
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
