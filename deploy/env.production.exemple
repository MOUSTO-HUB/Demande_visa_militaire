# Configuration de production : copier en « .env.production » à la racine du dépôt
# (jamais versionné), remplir, puis « chmod 600 .env.production ».
# Une copie de ce fichier, sous pli scellé dans un coffre, est INDISPENSABLE pour
# restaurer une sauvegarde : sans CLE_PIECES ni JWT_SECRET, les pièces et les
# doubles authentifications sont perdues.

# --- Adresse de la plateforme (réseau interne) ---
DOMAINE=visa.dgsic.defense.gn
# Certificat : « internal » (autorité de Caddy, à installer sur les postes), ou
# « /certificats/visa.crt /certificats/visa.key » (PKI de la DGSIC, dans deploy/certificats).
CADDY_TLS=internal
# Réseaux autorisés en plus des adresses privées (VPN à adresses publiques), séparés par des espaces.
RESEAUX_AUTORISES=
# Ports du serveur (80 et 443 sauf conflit).
PORT_HTTP=80
PORT_HTTPS=443

# --- Espace du militaire ouvert sur Internet (facultatif, voir deploy/caddy/sites) ---
# DOMAINE_ESPACE=espace-visa.defense.gn
# ESPACE_URL=https://espace-visa.defense.gn
# CADDY_TLS_ESPACE=admin@dgsic.defense.gn

# --- Base de données ---
POSTGRES_USER=visa
# node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
POSTGRES_PASSWORD=
POSTGRES_DB=demande_visa

# --- Secrets de l'API ---
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CLE_PIECES=

# --- Sauvegardes (chiffrées par cette phrase : 6 mots ou plus, notée dans le coffre) ---
SAUVEGARDE_PHRASE=
SAUVEGARDE_HEURE=02
SAUVEGARDE_JOURS=30

# --- Conservation des pièces : effacées N mois après la clôture de la campagne ---
CONSERVATION_MOIS=6
PURGE_AUTOMATIQUE=oui

# --- Messages aux militaires ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=non
SMTP_UTILISATEUR=
SMTP_MOT_DE_PASSE=
EMAIL_EXPEDITEUR=DGRECM <visa@dgrecm.defense.gn>
# SMS (optionnels) : passerelle HTTP du fournisseur, { to, from, message } en JSON.
SMS_URL=
SMS_JETON=
SMS_EXPEDITEUR=DGRECM
ENVOIS_AUTOMATIQUES=oui
